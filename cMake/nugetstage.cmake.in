# Generated by CMake, do not edit. Run through "cmake -P".
#
# Staging happens in script mode rather than at configure time because it needs
# the built import library and shared library, which do not exist yet when the
# project is configured.

set(CMAKE_SOURCE_DIR "@CMAKE_SOURCE_DIR@")
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "@CMAKE_ARCHIVE_OUTPUT_DIRECTORY@")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "@CMAKE_RUNTIME_OUTPUT_DIRECTORY@")
set(SPARSELIZARD_INCLUDE_STAGE_DIR "@SPARSELIZARD_INCLUDE_STAGE_DIR@")
set(PROJECT_VERSION "@PROJECT_VERSION@")

include("@CMAKE_SOURCE_DIR@/cMake/nuget.cmake")

message(STATUS "Staging sparselizard @PROJECT_VERSION@ into @_nuget_stage@")
sparselizard_stage_nuget("@_nuget_stage@"
    VERSION "@PROJECT_VERSION@"
    DEBUG_BUILD_DIR "@SPARSELIZARD_NUGET_DEBUG_DIR@"
    RUNTIME_DIRS "@SPARSELIZARD_RUNTIME_PATHS@"
    PETSC_INCLUDE_DIRS "@PETSc_INCLUDE_DIR@;@PETSc_CONF_INCLUDE_DIR@")

# NuGet's own pack target ships with the .NET SDK, so nothing has to be
# downloaded to produce the .nupkg. The stub project carries no code; it exists
# only to give "dotnet pack" something to hang the nuspec on.
file(WRITE "@_nuget_stage@/pack.csproj"
"<Project Sdk=\"Microsoft.NET.Sdk\">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NuspecFile>sparselizard.nuspec</NuspecFile>
    <NuspecBasePath>.</NuspecBasePath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
</Project>
")

find_program(_dotnet NAMES dotnet)
if(_dotnet)
    execute_process(
        COMMAND "${_dotnet}" pack pack.csproj --output "@_nuget_stage@"
        WORKING_DIRECTORY "@_nuget_stage@"
        RESULT_VARIABLE _rc
        OUTPUT_VARIABLE _out
        ERROR_VARIABLE _out)
    if(_rc EQUAL 0)
        message(STATUS "Package: @_nuget_stage@/sparselizard.@PROJECT_VERSION@.nupkg")
    else()
        message(WARNING "dotnet pack failed:\n${_out}")
    endif()
else()
    message(WARNING
        "No dotnet on PATH. The package layout is staged in @_nuget_stage@; "
        "pack it with \"nuget pack sparselizard.nuspec\" from there.")
endif()
