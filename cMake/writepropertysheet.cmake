# sparselizard_write_property_sheet
# ---------------------------------
# Write an MSBuild property sheet carrying everything a Visual Studio C++
# project needs to consume sparselizard. A .vcxproj cannot read a CMake package,
# so this is the equivalent artefact for that half of the world, generated from
# the same variables as sparselizardConfig.cmake and sparselizard-env.cmd.
#
#   sparselizard_write_property_sheet(<out-file>
#       INCLUDE_DIRS <dirs>    prepended to AdditionalIncludeDirectories
#       LIBRARY_DIRS <dirs>    prepended to AdditionalLibraryDirectories
#       LIBRARIES    <libs>    prepended to AdditionalDependencies
#       RUNTIME_DIRS <dirs>    prepended to PATH for the debugger
#       [RELATIVE_TO_SHEET]    emit the paths relative to the sheet itself,
#                              for a relocatable package rather than a build tree
#   )

function(sparselizard_write_property_sheet _out)
    cmake_parse_arguments(SP "RELATIVE_TO_SHEET" ""
        "INCLUDE_DIRS;LIBRARY_DIRS;LIBRARIES;RUNTIME_DIRS" ${ARGN})

    # $(MSBuildThisFileDirectory) always ends in a backslash, so a relative path
    # is appended to it directly.
    if(SP_RELATIVE_TO_SHEET)
        set(_root "$(MSBuildThisFileDirectory)")
    else()
        set(_root "")
    endif()

    # MSBuild separates list items with ';' and native paths use '\'.
    function(_sp_pathlist _var _dirs)
        set(_acc "")
        foreach(_d IN LISTS _dirs)
            if(_d STREQUAL "")
                continue()
            endif()
            file(TO_NATIVE_PATH "${_d}" _nd)
            string(REPLACE "&" "&amp;" _nd "${_nd}")
            string(REPLACE "<" "&lt;" _nd "${_nd}")
            string(REPLACE ">" "&gt;" _nd "${_nd}")
            if(_acc STREQUAL "")
                set(_acc "${_root}${_nd}")
            else()
                set(_acc "${_acc};${_root}${_nd}")
            endif()
        endforeach()
        set(${_var} "${_acc}" PARENT_SCOPE)
    endfunction()

    _sp_pathlist(_inc "${SP_INCLUDE_DIRS}")
    _sp_pathlist(_lib "${SP_LIBRARY_DIRS}")
    _sp_pathlist(_run "${SP_RUNTIME_DIRS}")
    string(REPLACE ";" ";" _deps "${SP_LIBRARIES}")

    set(_c "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n")
    string(APPEND _c "<!--\n")
    # An XML comment cannot contain a double hyphen, so none of the text below may.
    string(APPEND _c "  sparselizard ${PROJECT_VERSION}. Generated by CMake, do not edit.\n")
    string(APPEND _c "\n")
    string(APPEND _c "  Add this sheet through View > Property Manager and the project is done:\n")
    string(APPEND _c "  include directories, compiler requirements, link line and the loader\n")
    string(APPEND _c "  search path for the debugger all come from here.\n")
    string(APPEND _c "-->\n")
    string(APPEND _c "<Project ToolsVersion=\"4.0\" xmlns=\"http://schemas.microsoft.com/developer/msbuild/2003\">\n")
    string(APPEND _c "  <PropertyGroup Label=\"UserMacros\">\n")
    string(APPEND _c "    <SparselizardVersion>${PROJECT_VERSION}</SparselizardVersion>\n")
    string(APPEND _c "    <SparselizardRuntimeDirs>${_run}</SparselizardRuntimeDirs>\n")
    string(APPEND _c "    <SparselizardIncludeDirs>${_inc}</SparselizardIncludeDirs>\n")
    string(APPEND _c "  </PropertyGroup>\n")
    string(APPEND _c "\n")
    string(APPEND _c "  <!-- These headers go on ExternalIncludePath, not AdditionalIncludeDirectories.\n")
    string(APPEND _c "       The VC targets add that list to the include search path and to\n")
    string(APPEND _c "       EXTERNAL_INCLUDE both, so the headers are found and cl treats them as\n")
    string(APPEND _c "       external: they are not the application's code and it cannot act on what\n")
    string(APPEND _c "       they warn about. Its own warning level is untouched, only what is reached\n")
    string(APPEND _c "       through these directories goes quiet.\n")
    string(APPEND _c "\n")
    string(APPEND _c "       The VC_IncludePath guard is what makes this work from either position.\n")
    string(APPEND _c "       A sheet added through the Property Manager is imported after the toolset\n")
    string(APPEND _c "       settings and appends here; one imported by NuGet lands before them, where\n")
    string(APPEND _c "       ExternalIncludePath is still empty and assigning to it would suppress the\n")
    string(APPEND _c "       toolset's own default of the CRT and SDK directories. There the block is\n")
    string(APPEND _c "       skipped and the .targets, imported last, does the same append. -->\n")
    string(APPEND _c "  <PropertyGroup Condition=\"'$(VC_IncludePath)' != '' and '$(SparselizardExternalApplied)' != 'true'\">\n")
    string(APPEND _c "    <ExternalIncludePath>$(ExternalIncludePath);$(SparselizardIncludeDirs)</ExternalIncludePath>\n")
    string(APPEND _c "    <SparselizardExternalApplied>true</SparselizardExternalApplied>\n")
    string(APPEND _c "  </PropertyGroup>\n")
    string(APPEND _c "\n")
    string(APPEND _c "  <ItemDefinitionGroup>\n")
    string(APPEND _c "    <ClCompile>\n")
    string(APPEND _c "      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>\n")
    string(APPEND _c "      <!-- petscstring.h calls strncpy/strncat, which /sdl promotes from C4996 to an error. -->\n")
    string(APPEND _c "      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>\n")
    string(APPEND _c "      <!-- The PetscDefined() macros need a conforming preprocessor; the\n")
    string(APPEND _c "           traditional MSVC one mis-expands them into about 120 errors. -->\n")
    string(APPEND _c "      <UseStandardPreprocessor>true</UseStandardPreprocessor>\n")
    string(APPEND _c "      <!-- sparselizard passes std::string and std::vector across the DLL\n")
    string(APPEND _c "           boundary, so the application must use the same C runtime as the\n")
    string(APPEND _c "           library. See the check below for what happens otherwise. -->\n")
    string(APPEND _c "      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>\n")
    string(APPEND _c "      <BasicRuntimeChecks>Default</BasicRuntimeChecks>\n")
    string(APPEND _c "    </ClCompile>\n")
    string(APPEND _c "    <Link>\n")
    string(APPEND _c "      <AdditionalLibraryDirectories>${_lib};%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>\n")
    string(APPEND _c "      <AdditionalDependencies>${_deps};%(AdditionalDependencies)</AdditionalDependencies>\n")
    string(APPEND _c "    </Link>\n")
    string(APPEND _c "  </ItemDefinitionGroup>\n")
    string(APPEND _c "\n")
    string(APPEND _c "  <!-- Neither sparselizard.dll nor its dependencies sit in a directory the\n")
    string(APPEND _c "       loader searches by default. Without this, F5 fails at the first call\n")
    string(APPEND _c "       into MKL with 0xC06D007E and names no module. -->\n")
    string(APPEND _c "  <PropertyGroup>\n")
    string(APPEND _c "    <LocalDebuggerEnvironment>PATH=$(SparselizardRuntimeDirs);%PATH%\n")
    string(APPEND _c "$(LocalDebuggerEnvironment)</LocalDebuggerEnvironment>\n")
    string(APPEND _c "    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>\n")
    string(APPEND _c "  </PropertyGroup>\n")
    string(APPEND _c "\n")
    string(APPEND _c "  <!-- A project setting overrides an imported sheet, so the two requirements\n")
    string(APPEND _c "       that cannot be relaxed are checked rather than merely set. Both failures\n")
    string(APPEND _c "       are silent at build and link time: the debug CRT mismatch shows up as a\n")
    string(APPEND _c "       std::string arriving empty inside the library, and a Win32 build gets\n")
    string(APPEND _c "       unresolved externals that read as a missing library. -->\n")
    string(APPEND _c "  <Target Name=\"SparselizardCheckAbi\" BeforeTargets=\"ClCompile\">\n")
    string(APPEND _c "    <Error Condition=\"'$(Platform)' != 'x64'\"\n")
    string(APPEND _c "           Text=\"sparselizard ${PROJECT_VERSION} is x64 only; this project targets $(Platform).\" />\n")
    string(APPEND _c "    <Error Condition=\"'%(ClCompile.RuntimeLibrary)' == 'MultiThreadedDebugDLL' or '%(ClCompile.RuntimeLibrary)' == 'MultiThreadedDebug'\"\n")
    string(APPEND _c "           Text=\"sparselizard requires the release C runtime (/MD), including in Debug builds: it exchanges std::string and std::vector with the application, and the debug CRT lays them out differently (_ITERATOR_DEBUG_LEVEL 2 against 0). Nothing fails at build or link time -- the objects simply arrive corrupted. Set C/C++ > Code Generation > Runtime Library to 'Multi-threaded DLL (/MD)' and remove _DEBUG from the preprocessor definitions; /Od and /Zi are unaffected, the build stays debuggable.\" />\n")
    string(APPEND _c "  </Target>\n")
    string(APPEND _c "</Project>\n")

    file(WRITE "${_out}" "${_c}")
endfunction()
